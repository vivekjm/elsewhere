SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Planning's AI (optional): reads reels for places and suggests ideas. Without a key, places come from captions and
# rules only, and phones with Apple Intelligence use their own model. Set keys as Worker secrets in production
# (`npx wrangler secret put DEEPSEEK_API_KEY`), never as EXPO_PUBLIC_* (those ship inside the app).
# The main provider is AI_PROVIDER, else the first with a key: DeepSeek, Gemini, OpenAI.
# DEEPSEEK_API_KEY=
# AI_PROVIDER=deepseek          # deepseek | gemini | openai
# AI_MODEL=deepseek-flash       # defaults: deepseek-flash, gemini-3.5-flash-lite, gpt-6-luna
# Tried when the main provider is down or out of balance (needs its own key):
# AI_FALLBACK_PROVIDER=gemini
# AI_FALLBACK_MODEL=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# A compatible gateway in front of a provider (HTTPS only), e.g. DEEPSEEK_BASE_URL=https://gateway.example.com/deepseek
# DEEPSEEK_BASE_URL=
# Model calls per UTC day for all accounts together (each account also has 40); default 20000:
# AI_DAILY_GLOBAL_LIMIT=20000
# Switch AI off everywhere without removing keys:
# AI_DISABLED=1
